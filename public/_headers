# Cloudflare Pages / Netlify style headers.
# GitHub Pages ignores this file for HTTP headers, but if you put Cloudflare
# in front of www.data-brains.net (orange cloud), create a Cache Rule:
#   If URI Path starts with /assets/
#   Then Edge TTL = 1 month, Browser TTL = 1 year, Cache Everything
#
# Hashed Vite assets are immutable; index.html should stay short-lived.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/og-image.jpg
  Cache-Control: public, max-age=604800

/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/404.html
  Cache-Control: public, max-age=0, must-revalidate
