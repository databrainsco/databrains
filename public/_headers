# Cloudflare Pages / Netlify style headers.
# GitHub Pages IGNORES this file for HTTP headers (always max-age=600).
# To fix "Use efficient cache lifetimes", put Cloudflare in front of
# www.data-brains.net (proxied DNS) and add a Cache Rule:
#   If URI Path starts with /assets/ OR /fonts/
#   Then Edge Cache TTL = 1 month, Browser TTL = 1 year, Cache Everything
#
# Hashed Vite assets under /assets/ are immutable across deploys.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/og-image.jpg
  Cache-Control: public, max-age=604800

/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/404.html
  Cache-Control: public, max-age=0, must-revalidate
